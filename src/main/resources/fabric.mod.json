{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_issues}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "assets/ubesdelight/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "chefmooon.ubesdelight.UbesDelight"
    ],
    "client": [
      "chefmooon.ubesdelight.client.UbesDelightClient"
    ],
    "fabric-datagen": [
      "chefmooon.ubesdelight.data.DataGenerationFabric"
    ],
    "jei_mod_plugin": [
      "chefmooon.ubesdelight.integration.jei.JEIPlugin"
    ],
    "rrv_client": [
      "chefmooon.ubesdelight.integration.rrv.RRVPlugin"
    ]
  },
  "mixins": [
    "ubesdelight.mixins.json"
  ],
  "accessWidener": "ubesdelight.classtweaker",
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_min_version} <=${minecraft_max_version}",
    "farmersdelight": ">=26.1-3.5.2+refabricated"
  },
  "conflicts": {
    "rrv": "<8.0.0"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.wiki": "${mod_homepage}",
        "modmenu.discord": "${mod_discord}"
      }
    }
  }
}